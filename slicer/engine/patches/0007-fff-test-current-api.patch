diff --git a/tests/fff_print/test_data.hpp b/tests/fff_print/test_data.hpp
--- a/tests/fff_print/test_data.hpp
+++ b/tests/fff_print/test_data.hpp
@@ -15,3 +15,20 @@
 constexpr double MM_PER_MIN = 60.0;
 
+// Object brim paths are now stored per object. Preserve aggregate test counts.
+inline size_t brim_items_count(Print &print)
+{
+    size_t count = 0;
+    for (const auto &entry : print.get_brimMap())
+        count += entry.second.items_count();
+    return count;
+}
+
+inline size_t brim_entities_count(Print &print)
+{
+    size_t count = 0;
+    for (const auto &entry : print.get_brimMap())
+        count += entry.second.entities.size();
+    return count;
+}
+
 /// Enumeration of test meshes
