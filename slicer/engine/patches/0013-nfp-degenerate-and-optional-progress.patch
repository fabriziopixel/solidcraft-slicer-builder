+
+TEST_CASE("NFP placer rejects degenerate contours before vertex access", "[Nesting]") {
+    NfpPlacer placer(Box(250000000, 210000000));
+    std::vector<Item> items = {
+        Item{}, Item{{0, 0}}, Item{{0, 0}, {10, 0}, {20, 0}}
+    };
+    for (auto &item : items) {
+        REQUIRE(item.area() == 0.);
+        for (bool wipe_tower : {false, true}) {
+            item.is_wipe_tower = wipe_tower;
+            auto result = placer.pack(item);
+            REQUIRE_FALSE(bool(result));
+            REQUIRE(result.score() < 0.);
+            REQUIRE(item.binId() == BIN_ID_UNSET);
+            REQUIRE(placer.getItems().empty());
+        }
+    }
+}
+
+TEST_CASE("NFP progress callback can be omitted with packed items", "[Nesting]") {
+    NfpPlacer placer(Box(250000000, 210000000));
+    NfpPlacer::Config config;
+    unsigned notifications = 0;
+    SECTION("Callback omitted") {
+        REQUIRE_FALSE(bool(config.progressFunc));
+    }
+    SECTION("Callback supplied") {
+        config.progressFunc = [&notifications](const std::string&) { ++notifications; };
+    }
+    placer.configure(config);
+    Item first(RectangleItem{10000000, 10000000});
+    auto result = placer.pack(first);
+    REQUIRE(bool(result));
+    placer.accept(result);
+    REQUIRE(placer.getItems().size() == 1);
+    Item second(RectangleItem{10000000, 10000000});
+    REQUIRE_NOTHROW(placer.pack(second));
+    if (config.progressFunc) REQUIRE(notifications > 0);
 }
 
